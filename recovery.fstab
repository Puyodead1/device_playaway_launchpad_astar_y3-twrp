/bootloader     vfat     /dev/block/nanda     flags=display=bootloader
/env            emmc     /dev/block/nandb     flags=display=env
/boot           emmc     /dev/block/nandc     flags=display=boot;backup=1;flashimg=1
/system         ext4     /dev/block/nandd     flags=display=system;backup=1;wipeingui
/data           ext4     /dev/block/nandj     flags=display=data;backup=1;wipeingui
/misc           emmc     /dev/block/nande     flags=display=misc
/recovery       emmc     /dev/block/nandf     flags=display=recovery;backup=1;flashimg=1
/cache          ext4     /dev/block/nandg     flags=display=cache;wipeingui